{
  "name": "@camcima/nestjs-memory-microservices",
  "version": "0.2.1",
  "description": "In-memory NestJS microservice transport for testing — full pipeline, zero broker",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "release": "release-it",
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm run build",
    "security:audit": "pnpm audit --prod",
    "security:secrets": "gitleaks detect --redact --no-banner"
  },
  "keywords": [
    "nestjs",
    "microservices",
    "testing",
    "in-memory",
    "transport",
    "custom-transport",
    "event-pattern",
    "message-pattern"
  ],
  "author": "camcima (https://github.com/camcima)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camcima/nestjs-memory-microservices.git"
  },
  "homepage": "https://github.com/camcima/nestjs-memory-microservices",
  "bugs": {
    "url": "https://github.com/camcima/nestjs-memory-microservices/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/microservices": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/microservices": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/testing": "^11.1.27",
    "@swc/core": "^1.15.43",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.4",
    "reflect-metadata": "^0.2.2",
    "release-it": "^20.2.0",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": ">=5.3.0",
      "defu": ">=6.1.5",
      "esbuild": ">=0.28.1",
      "lodash": ">=4.18.0",
      "multer": ">=2.2.0",
      "postcss": ">=8.5.10",
      "undici": ">=8.5.0",
      "vite": ">=7.3.5 <8"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.17.0"
}
